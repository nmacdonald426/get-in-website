# Copy this file to .env.local for local testing, and paste the same two
# values into Vercel under Settings > Environment Variables.
# Never put the service_role key or the database password in here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
